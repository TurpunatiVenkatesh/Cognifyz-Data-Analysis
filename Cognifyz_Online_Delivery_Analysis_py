import pandas as pd
import matplotlib.pyplot as plt

# Load the dataset
df = pd.read_csv("zomato.csv")

# Calculate restaurant counts
counts = df["Has Online delivery"].value_counts()
percentages = df["Has Online delivery"].value_counts(normalize=True) * 100
ratings = df.groupby("Has Online delivery")["Aggregate rating"].mean()

# Display results
print("Online Delivery Analysis")
print("------------------------")
print("Restaurant counts:\n", counts)
print("\nPercentages:\n", percentages.round(2))
print("\nAverage ratings:\n", ratings.round(2))

# Save results to CSV
results = pd.DataFrame({
    "Restaurant Count": counts,
    "Percentage (%)": percentages,
    "Average Rating": ratings
})
results.to_csv("Online_Delivery_Results.csv")

# Create percentage chart
percentages.plot(kind="bar", title="Online Delivery Availability")
plt.ylabel("Restaurants (%)")
plt.tight_layout()
plt.savefig("Online_Delivery_Percentage.png")
plt.show()
